# ── LLM Configuration ────────────────────────────────────
# Ollama local LLM model (e.g., mistral, llama2, neural-chat)
OLLAMA_MODEL=mistral

# ── LangFuse Observability ───────────────────────────────
# Get these from https://www.langfuse.com/
LANGFUSE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Database Configuration ──────────────────────────────
# ChromaDB persistence path (optional, defaults to ./chroma_db)
CHROMA_DB_PATH=./chroma_db

# ── API Configuration ───────────────────────────────────
# FastAPI server host and port
API_HOST=0.0.0.0
API_PORT=8000

# ── OpenAI API (Optional - if using OpenAI instead of Ollama) ─
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4

# ── PDF & Resume Processing ────────────────────────────
# Max file size for uploads (in MB)
MAX_FILE_SIZE=10

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
